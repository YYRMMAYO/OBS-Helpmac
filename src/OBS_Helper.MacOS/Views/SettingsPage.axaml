<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OBS_Helper.MacOS.Views.SettingsPage">
  <ScrollViewer Padding="28,24" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" MaxWidth="860" HorizontalAlignment="Left">

      <!-- 外观 -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="外观" Classes="h2" />
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="主题" VerticalAlignment="Center" />
            <RadioButton x:Name="ThemeLight" GroupName="theme" Content="浅色" Margin="0,0,8,0"
                         Checked="OnThemeChanged" />
            <RadioButton x:Name="ThemeDark" GroupName="theme" Content="深色"
                         Checked="OnThemeChanged" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- OBS 连接 -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="OBS 连接" Classes="h2" />
          <CheckBox x:Name="AutoConnect" Content="启动时自动连接 OBS" />
          <CheckBox x:Name="RememberPassword" Content="记住连接密码（存入系统钥匙串）" />
          <TextBlock Classes="muted"
                     Text="提示：在 OBS「工具 → WebSocket 服务器设置」中开启并查看端口与密码。" />
        </StackPanel>
      </Border>

      <!-- AI 引擎 -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="AI 诊断引擎" Classes="h2" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <RadioButton x:Name="EngineLocal" GroupName="engine" Content="本地引擎（默认 · 离线）" Margin="0,0,12,0" />
            <RadioButton x:Name="EngineCloud" GroupName="engine" Content="云端大模型（OpenAI 兼容）" />
          </StackPanel>
          <TextBox x:Name="CloudUrlBox" Watermark="接口地址，如 https://api.openai.com/v1/chat/completions" />
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
            <TextBox x:Name="CloudKeyBox" Watermark="API Key（存入钥匙串）" PasswordChar="•" Grid.ColumnSpan="1" />
            <TextBox x:Name="CloudModelBox" Grid.Column="1" Watermark="模型名，如 gpt-4o-mini" />
            <Button x:Name="SaveAiBtn" Grid.Column="2" Classes="primary" Content="保存 AI 设置" Click="OnSaveAi" />
          </Grid>
          <TextBlock x:Name="AiStatusText" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- 关于 -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="关于" Classes="h2" />
          <TextBlock x:Name="AboutText" Classes="muted" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="secondary" Content="检查更新" Click="OnCheckUpdate" />
            <Button Classes="ghost" Content="项目主页" Click="OnOpenRepo" />
          </StackPanel>
          <TextBlock x:Name="UpdateText" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
