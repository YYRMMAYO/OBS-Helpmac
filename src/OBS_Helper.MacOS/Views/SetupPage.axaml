<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OBS_Helper.MacOS.Views.SetupPage">
  <ScrollViewer Padding="28,24" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="14" MaxWidth="860" HorizontalAlignment="Left">
      <TextBlock Text="macOS 直播间搭建清单" Classes="h2" Margin="2,0,0,0" />
      <ItemsControl x:Name="StepList" ><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="card">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <CheckBox IsChecked="{Binding Done}" Checked="OnStepChanged" Unchecked="OnStepChanged"
                          Tag="{Binding Index}" VerticalAlignment="Top" />
                <StackPanel>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Detail}" Classes="muted" Margin="0,4" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
