<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <Version>2.1.0</Version>
    <InformationalVersion>2.1.0</InformationalVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Copyright>Copyright (c) 2026 OBS Helper</Copyright>
    <Authors>OBS Helper</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/YYRMMAYO/OBS-Helpmac</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.2" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.2" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内嵌资源：问题库与场景模板离线可用，无需网络加载 -->
    <EmbeddedResource Include="Assets\problems.json" />
    <EmbeddedResource Include="Assets\scene_templates.json" />
    <Content Include="Assets\appicon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
