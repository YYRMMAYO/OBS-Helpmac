{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "默认能力：允许主窗口与小窗运行前端页面，允许原生文件对话框（导出 / 导入备份与场景模板）、全局快捷键、系统通知与 Tauri 事件监听（托盘 / 热键动作转发）。",
  "windows": ["main", "mini"],
  "permissions": [
    "core:default",
    "dialog:default",
    "global-shortcut:default",
    "notification:default"
  ]
}
